# Server-side model gateway (for example, a private LiteLLM Proxy). Never use NEXT_PUBLIC_ for secrets.
KRUSHY_MODEL_BASE_URL=
KRUSHY_MODEL_API_KEY=
# JSON object: stable KRUSHY model IDs -> exact gateway aliases. Example:
# KRUSHY_MODEL_MAP={"kimi-k3":"moonshot/Kimi-K3","qwen-general":"qwen/Qwen3.8-27B"}
KRUSHY_MODEL_MAP=

# Optional direct provider keys for future native SDK integrations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
