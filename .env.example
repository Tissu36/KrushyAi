# Server-side model gateway (for example, a private LiteLLM Proxy).
# Never use NEXT_PUBLIC_ for secrets, and never commit .env.local.
KRUSHY_MODEL_BASE_URL=
KRUSHY_MODEL_API_KEY=

# Stable KRUSHY slot IDs -> exact aliases configured in your gateway.
# These are conservative documented API targets; provider access and billing still apply.
# Carbon / Fable availability can vary by provider account. Use fallbacks if unavailable.
KRUSHY_MODEL_MAP={"slot-1-flagship":"anthropic/claude-opus-5","slot-2-writing":"anthropic/claude-sonnet-5","slot-3-multimodal":"gemini/gemini-3.8-flash","slot-4-coding":"anthropic/claude-opus-5","slot-5-fast":"gemini/gemini-3.8-flash","slot-6-research":"gemini/gemini-3.8-flash","slot-7-vision":"gemini/gemini-3.8-flash","slot-8-agents":"gemini/gemini-3.8-flash","slot-9-math-science":"anthropic/claude-opus-5","slot-10-backup":"gemini/gemini-3.8-flash"}

# Optional direct provider keys for future native SDK integrations.
# Keep these server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
