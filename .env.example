# Server-side model gateway (for example, a private LiteLLM Proxy).
# Never use NEXT_PUBLIC_ for secrets, and never commit .env.local.
KRUSHY_MODEL_BASE_URL=https://openrouter.ai/api/v1
KRUSHY_MODEL_API_KEY=your_openrouter_api_key

# Stable KRUSHY slot IDs -> exact aliases configured in your gateway.
# These are conservative documented API targets; provider access and billing still apply.
# Carbon / Fable availability can vary by provider account. Use fallbacks if unavailable.
KRUSHY_MODEL_MAP={"slot-1-flagship":"nvidia/nemotron-3-ultra:free","slot-2-writing":"baidu/ernie-5.5-flash-preview:free","slot-3-multimodal":"nvidia/nemotron-3.5-super-vl:free","slot-4-coding":"cohere/north-mini-code:free","slot-5-fast":"nvidia/nemotron-3.5-lightning:free","slot-6-research":"dots-studio/dots3-note-preview:free","slot-7-vision":"inclusionai/ling-3.2-flash:free","slot-8-agents":"particle-ai/particle-1:free","slot-9-math-science":"nvidia/nemotron-3-ultra:free","slot-10-backup":"google/gemma-4-31b:free"}

# Free-only fallback aliases. Every listed endpoint is a :free model ID.
KRUSHY_MODEL_FALLBACK_MAP={"slot-1-flagship":["nvidia/nemotron-3.5-lightning:free","baidu/ernie-5.5-flash-preview:free"],"slot-2-writing":["nvidia/nemotron-3-ultra:free","google/gemma-4-31b:free"],"slot-3-multimodal":["inclusionai/ling-3.2-flash:free"],"slot-4-coding":["particle-ai/particle-1:free"],"slot-5-fast":["baidu/ernie-5.5-flash-preview:free","google/gemma-4-31b:free"],"slot-6-research":["nvidia/nemotron-3-ultra:free","baidu/ernie-5.5-flash-preview:free"],"slot-7-vision":["nvidia/nemotron-3.5-super-vl:free"],"slot-8-agents":["cohere/north-mini-code:free","nvidia/nemotron-3-ultra:free"],"slot-9-math-science":["baidu/ernie-5.5-flash-preview:free"],"slot-10-backup":["nvidia/nemotron-3.5-lightning:free","baidu/ernie-5.5-flash-preview:free"]}

# Optional direct provider keys for future native SDK integrations.
# Keep these server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
